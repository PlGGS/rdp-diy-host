# Builds rdp.diy Host for Linux and packages it as a .deb.
#   docker build -f rdpdiy/Dockerfile.linux -o out \
#     --build-arg RDPDIY_ID_SERVER=rdp.diy --build-arg RDPDIY_KEY=<hbbs key> .
FROM debian:bookworm AS build
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git build-essential clang libclang-dev cmake nasm pkg-config \
      libgtk-3-dev libxcb-randr0-dev libxdo-dev libxfixes-dev libxcb-shape0-dev libxcb-xfixes0-dev \
      libasound2-dev libpulse-dev libpam0g-dev libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
      libva-dev libvpx-dev libyuv-dev libaom-dev libopus-dev libssl-dev libunwind-dev dpkg-dev \
 && rm -rf /var/lib/apt/lists/*
# Debian's libyuv-dev has no pkg-config file; scrap's linux-pkg-config build needs one.
RUN printf 'prefix=/usr\nlibdir=/usr/lib/%s\nincludedir=/usr/include\nName: libyuv\nDescription: libyuv\nVersion: 0\nLibs: -L${libdir} -lyuv\nCflags: -I${includedir}\n' \
      "$(dpkg-architecture -qDEB_HOST_MULTIARCH)" > /usr/share/pkgconfig/libyuv.pc
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.81
ENV PATH=/root/.cargo/bin:$PATH CARGO_NET_GIT_FETCH_WITH_CLI=true CARGO_NET_RETRY=10
WORKDIR /src
COPY . .
ARG RDPDIY_ID_SERVER=rdp.diy
ARG RDPDIY_RELAY_SERVER=rdp.diy:21117
ARG RDPDIY_API_SERVER=https://rdp.diy
ARG RDPDIY_KEY=
ENV RDPDIY_ID_SERVER=$RDPDIY_ID_SERVER RDPDIY_RELAY_SERVER=$RDPDIY_RELAY_SERVER \
    RDPDIY_API_SERVER=$RDPDIY_API_SERVER RDPDIY_KEY=$RDPDIY_KEY
# build.rs normally writes src/version.rs, but skips it when target/ is restored from cache.
RUN --mount=type=cache,target=/root/.cargo/registry --mount=type=cache,target=/src/target \
    printf 'pub const VERSION: &str = "%s";\n#[allow(dead_code)]\npub const BUILD_DATE: &str = "%s";\n' \
      "$(grep -m1 '^version' Cargo.toml | cut -d'"' -f2)" "$(date -u '+%Y-%m-%d %H:%M')" > src/version.rs \
 && cargo build --release --features rdpdiy,linux-pkg-config \
 && mkdir -p /out && cp target/release/rustdesk /out/rdpdiy-host
RUN rdpdiy/package-deb.sh /out/rdpdiy-host /out

FROM scratch
COPY --from=build /out/*.deb /
